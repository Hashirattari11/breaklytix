# Copy to .env (or export in your shell). Never commit the real file.

# AI email drafting. Without it, deterministic templates are used instead.
ANTHROPIC_API_KEY=

# Optional search providers. With none set, prospecting runs on seeds + CSV.
SERPER_API_KEY=
BRAVE_API_KEY=

# Only needed for directory_submit.py browser login - the agent never types
# your password itself, so these are unused by default.
# GMAIL_TOKEN_PATH=data/gmail_token.json
