# Repo root is uploaded for both Vercel projects. The frontend project builds
# frontend/, while the backend project uses root directory "backend/" and needs
# backend/ included or its Python function is silently omitted.
# Keep secrets, logs, local state, and unrelated trees out of the bundle.
# NOTE: Vercel always excludes .git and .env* regardless of this file.

# secrets + local env (belt-and-suspenders on top of Vercel's .env* rule)
.env.local
.env*.local

# local logs
*.log
.devserver*.log
.prodserver*.log

# local tool / editor state
.agents/
.pytest_cache/
.vercel.bak
.vercel.bak2

# Vercel project state (must not be bundled)
.vercel/

# unrelated CLI / data trees at the REPO ROOT only.
# These MUST stay root-anchored (leading "/"): an unanchored `cli/` also matched
# `frontend/app/dashboard/cli/`, so Vercel silently dropped that route from the
# upload and the deployed site returned 404 for /dashboard/cli even though the
# local build contained it.
/cli/
/db/
/examples/
/bx/

# generated reports / scratch scripts at repo root
*_REPORT.md
*_REPORT.txt
*_STATUS.md
_audit*.py
_apply_*.py
_extract_*.py
