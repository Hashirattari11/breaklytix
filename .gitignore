# ---- Environment / secrets ----
.env
.env.local
.env.*.local
*.pem

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Vercel (any variant, not just the canonical folder) ----
# Vercel's own .vercel/README.txt says the folder must not be shared.
.vercel*
!.vercel/.gitignore
# Root .vercelignore IS shared config: the project Root Directory is
# "frontend", so root deploys upload the whole tree — this file keeps
# secrets/logs/unrelated dirs out of the deployment bundle.
!.vercelignore

# ---- Local deploy / tooling scratch ----
# Ad-hoc patch, sweep and repair scripts and their output logs.
_*.py
_*.log
*_deploy*.log
deploy_*.txt
deploy_*.log
*_deploy_rc.txt
*_deploy_target_*.txt
deploy_log.txt
prod_url.txt
name_prod.txt
final_deploy_report.txt
*.bak
.vercel.log
.devserver*.log
.prodserver.log
dt_*.json
err.txt
out.txt

